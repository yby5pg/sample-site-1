---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../lib/sanity';

const query = `*[_type == "homePage"][0]{
  bio,
  "headshots": headshots[].asset->url
}`;

const data = await client.fetch(query);
const headshots: string[] = data?.headshots || [];
---

<BaseLayout title="Home">
  <section class="headshot-grid">
    {headshots.length > 0 ? (
      headshots.map((url, i) => (
        <div class="headshot-frame">
          <img src={url} alt={`Headshot ${i + 1}`} loading="lazy" />
        </div>
      ))
    ) : (
      <>
        <div class="headshot-frame"><div class="placeholder">Headshot 1</div></div>
        <div class="headshot-frame"><div class="placeholder">Headshot 2</div></div>
        <div class="headshot-frame"><div class="placeholder">Headshot 3</div></div>
      </>
    )}
  </section>

  {data?.bio && (
    <section class="bio-section">
      <p class="bio-text">{data.bio}</p>
    </section>
  )}
</BaseLayout>

<style>
  .headshot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 3rem 0 2.5rem 0;
  }

  .headshot-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #f4f4f4;
    border: 1px solid var(--border-light, #e5e5e5);
    overflow: hidden;
  }

  .headshot-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted, #888);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .bio-section {
    max-width: 700px;
    margin: 0 auto 4rem auto;
    text-align: center;
  }

  .bio-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-main, #222);
    white-space: pre-line;
  }

  @media (max-width: 640px) {
    .headshot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>