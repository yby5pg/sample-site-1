---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../lib/sanity';

const query = `*[_type == "headshotResume"][0]{
  "headshotUrl": downloadableHeadshot.asset->url,
  "resumeUrl": resumePdf.asset->url
}`;

const data = await client.fetch(query);
---

<BaseLayout title="Headshot + Resume">
  <div class="page-container">
    <div class="downloads">
      {data?.headshotUrl && (
        <a href={data.headshotUrl} download target="_blank" rel="noopener noreferrer" class="download-btn">
          Download Headshot
        </a>
      )}
      {data?.resumeUrl && (
        <a href={data.resumeUrl} download target="_blank" rel="noopener noreferrer" class="download-btn">
          Download Resume (PDF)
        </a>
      )}
    </div>

    {data?.headshotUrl && (
      <div class="headshot-preview">
        <img src={data.headshotUrl} alt="Headshot Preview" />
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 600px;
    margin: 3rem auto;
    text-align: center;
  }

  .downloads {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .download-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--text-main, #111);
    color: var(--text-main, #111);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .download-btn:hover {
    background-color: var(--text-main, #111);
    color: #fff;
  }

  .headshot-preview {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    aspect-ratio: 4 / 5;
    background-color: #f4f4f4;
    overflow: hidden;
    border: 1px solid var(--border-light, #e5e5e5);
  }

  .headshot-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>